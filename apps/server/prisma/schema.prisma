datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider  = "prisma-client-py"
  interface = "asyncio"
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model Notification {
  id             String             @id @default(uuid())
  phoneNumber    String             @map("phone_number")
  messageBody    String             @map("message_body")
  status         NotificationStatus @default(PENDING)
  evolutionMsgId String?            @map("evolution_msg_id")
  retryCount     Int                @default(0) @map("retry_count")
  errorReason    String?            @map("error_reason")
  createdAt      DateTime           @default(now()) @map("created_at")
  sentAt         DateTime?          @map("sent_at")

  // Performance Indexing for fast status lookups
  @@index([status, createdAt])
  @@map("notifications")
}

enum Role {
  STUDENT
  ADMIN
}

model User {
  id                String    @id @default(cuid())
  name              String
  email             String    @unique
  emailVerified     Boolean   @default(false)
  image             String?
  role              Role      @default(STUDENT)
  whatsappNumber    String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  sessions          Session[]
  accounts          Account[]

  @@map("user")
  vulmsAccounts VulmsAccount[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

model VulmsAccount {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  studentId           String
  encryptedPassword   String

  isActive            Boolean  @default(true)
  aspSessionId        String

  lastAssignmentHash  String?
  lastQuizHash        String?
  lastGdbHash         String?
  lastPolledAt        DateTime?
  lastAuthFailedAt    DateTime?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([isActive])
}